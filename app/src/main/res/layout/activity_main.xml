<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:background="@color/background_color"
            android:textColor="@color/text_color"
            android:gravity="end|center_vertical"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="16dp"
            android:textSize="32sp"
            android:hint="Įveskite skaičius"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="5"
            android:columnCount="5"
            android:rowCount="6">

            <Button
                android:id="@+id/btnMC"
                style="@style/CalcButton"
                android:layout_row="0"
                android:layout_column="0"
                android:text="@string/btnMC" />

            <Button
                android:id="@+id/btnMR"
                style="@style/CalcButton"
                android:layout_row="0"
                android:layout_column="1"
                android:text="@string/btnMR" />

            <Button
                android:id="@+id/btnMS"
                style="@style/CalcButton"
                android:layout_row="0"
                android:layout_column="2"
                android:text="@string/btnMS" />

            <Button
                android:id="@+id/btnMMplus"
                style="@style/CalcButton"
                android:layout_row="0"
                android:layout_column="3"
                android:text="@string/btnMMplus" />

            <Button
                android:id="@+id/btnMMinus"
                style="@style/CalcButton"
                android:layout_row="0"
                android:layout_column="4"
                android:text="@string/btnMMinus" />

            <Button
                android:id="@+id/btnBack"
                style="@style/CalcButton"
                android:layout_row="1"
                android:layout_column="0"
                android:text="@string/btnBack" />

            <Button
                android:id="@+id/btnCE"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="1"
                android:layout_column="1"
                android:text="@string/btnCE" />

            <Button
                android:id="@+id/btnC"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="1"
                android:layout_column="2"
                android:text="@string/btnC" />

            <Button
                android:id="@+id/btnPlusMinus"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="1"
                android:layout_column="3"
                android:text="@string/btnPlusMinus" />

            <Button
                android:id="@+id/btnSqrt"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="1"
                android:layout_column="4"
                android:text="@string/btnSqrt" />

            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="2"
                android:layout_column="0"
                android:text="@string/btn7" />

            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="2"
                android:layout_column="1"
                android:text="@string/btn8" />

            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="2"
                android:layout_column="2"
                android:text="@string/btn9" />

            <Button
                android:id="@+id/btnDiv"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="2"
                android:layout_column="3"
                android:text="@string/btnDiv" />

            <Button
                android:id="@+id/btnPerc"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="2"
                android:layout_column="4"
                android:text="@string/btnPerc" />

            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="3"
                android:layout_column="0"
                android:text="@string/btn4" />

            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="3"
                android:layout_column="1"
                android:text="@string/btn5" />

            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="3"
                android:layout_column="2"
                android:text="@string/btn6" />

            <Button
                android:id="@+id/btnMulti"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="3"
                android:layout_column="3"
                android:text="@string/btnMulti" />

            <Button
                android:id="@+id/btnInve"
                style="@style/CalcButton"
                android:layout_row="3"
                android:layout_column="4"
                android:text="@string/btnInve" />

            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="4"
                android:layout_column="0"
                android:text="@string/btn1" />

            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="4"
                android:layout_column="1"
                android:text="@string/btn2" />

            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="4"
                android:layout_column="2"
                android:text="@string/btn3" />

            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="4"
                android:layout_column="3"
                android:text="@string/btnMinus" />

            <Button
                android:id="@+id/btnEquals"
                android:onClick="onBtnClick"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="4"
                android:layout_rowSpan="2"
                android:layout_column="4"
                android:layout_rowWeight="2"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="2dp"
                android:text="@string/btnEquals" />

            <Button
                android:id="@+id/btn0"
                android:onClick="onBtnClick"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="5"
                android:layout_column="0"
                android:layout_columnSpan="2"
                android:layout_rowWeight="1"
                android:layout_columnWeight="2"
                android:layout_gravity="fill"
                android:layout_margin="2dp"
                android:text="@string/btn0" />

            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="5"
                android:layout_column="2"
                android:text="@string/btnDot" />

            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton"
                android:onClick="onBtnClick"
                android:layout_row="5"
                android:layout_column="3"
                android:text="@string/btnPlus" />

        </GridLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>